# Copy this file to zsh.config/.zshrc.local (gitignored) and put
# host-specific / employer aliases here - real IPs, internal hostnames,
# k8s cluster queries, etc. .zshrc sources it automatically if present.

# Lambda prompt line-1 badges, both set automatically by `install.sh
# --server`, edit by hand any time to change them. See
# zsh.config/lambda-00x097.zsh-theme. Order on the prompt: [PROVIDER]
# [TYPE] user@host:path - PROVIDER first.
#
# CLOUD_PROVIDER: AWS/OVH/AZURE/GCP/HETZNER get a fixed color; anything
# else is a custom label, colored by CLOUD_PROVIDER_COLOR (a 256-color
# number, 'spectrum_ls' in zsh previews the scale) or plain gray if unset.
# export CLOUD_PROVIDER="HETZNER"
# export CLOUD_PROVIDER="homelab"
# export CLOUD_PROVIDER_COLOR="213"
#
# SERVER_TYPE: DEV green, PROD bold red, anything else (a custom label)
# yellow by default - or SERVER_TYPE_COLOR (same 256-color number idea as
# CLOUD_PROVIDER_COLOR) for a different shade.
# export SERVER_TYPE="PROD"
# export SERVER_TYPE="staging"
# export SERVER_TYPE_COLOR="51"

# Per-host SSH shortcuts (ssh node000, ...) go in ~/.ssh/config as Host
# blocks instead of aliases here - see README's "Keeping secrets out of a
# public repo" section:
#
# Host node000
#     HostName 203.0.113.10
#     User root
#     IdentityFile ~/.ssh/hetzner_accesses

alias k8s-pvc-per-node='kubectl get pv -o custom-columns="NAME:.metadata.name,CAPACITY:.spec.capacity.storage,CLAIM:.spec.claimRef.name,NODE:.spec.nodeAffinity.required.nodeSelectorTerms[0].matchExpressions[0].values[0]"'
